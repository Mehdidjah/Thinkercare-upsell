# Example environment for Touché Conseil.
# Nothing loads this file automatically: export the variables in your shell
# (for example `set -a; . ./.env; set +a`), or start Node with
# `node --env-file=.env backend/dist/main.js`.

# PostgreSQL connection string (on Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/touche

# Comma-separated exact origins allowed to POST to the API.
# Required in production: the server refuses to start without it.
# Railway-only deploy: https://${{RAILWAY_PUBLIC_DOMAIN}} (or https://<your custom domain>).
# Vercel frontend + Railway API: the Vercel site origin, e.g. https://<project>.vercel.app.
APP_ORIGIN=http://localhost:3000,http://localhost:5173

# development, test or production (production on Railway)
NODE_ENV=development

# HTTP port the server listens on (Railway injects it)
PORT=3000

# Number of reverse proxies in front of the app: 0 locally, where there is none.
# Railway-only deploy needs 1 (Railway edge). Vercel frontend + Railway API needs 2
# (Vercel rewrite, then Railway edge), so the login throttle sees the real client IP.
TRUST_PROXY=0
