# ─────────────────────────────────────────────────────────────
# Touché Conseil — repository ignore rules
# These paths are generated, downloaded, local-only, or OS junk.
# None of them affect how the project works: they are rebuilt by
# `npm ci` / `npm run build`, or they hold local secrets.
# (Patterns without a leading slash match at any depth, so these
#  also cover frontend/node_modules, backend/dist, etc.)
# ─────────────────────────────────────────────────────────────

# Dependencies (regenerated by `npm ci`)
node_modules/

# Build output (regenerated by `npm run build`)
dist/
.output/
.vinxi/
.nitro/

# Local private state
.private/

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / IDE settings
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# Non-runtime documentation & handoff material
# Kept on disk, never committed. Nothing in the build, tests or app reads
# these files. Leading "/" anchors each pattern to this exact path.
/documentation/
/GUIDE_DE_TRANSMISSION.html
/LIRE_EN_PREMIER.md

# Working documents (design specs, implementation plans)
/docs/

# AI agent working files (task briefs, review packages, progress ledger)
/.superpowers/

# Archive provenance (stale since the restructure; describes the old export)
/MANIFEST_SHA256.txt
/VERSION.json
/verification.json

# TypeScript incremental build info
*.tsbuildinfo
.vercel
